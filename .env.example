# ---- Inbound: what SAO must present -----------------------------------------
# Configure SAO's webhook with auth type "Header token" and this value.
WEBHOOK_TOKEN=change-me-to-a-long-random-string
# Set true ONLY for local testing without a token. Logs a loud warning.
ALLOW_INSECURE=false

# ---- Outbound: Splunk HEC ----------------------------------------------------
# Base URL only. The app appends /services/collector/event
# Splunk Enterprise:  https://splunk.example.com:8088
# Splunk Cloud:       https://http-inputs-<stack>.splunkcloud.com:443
HEC_URL=https://splunk.example.com:8088
HEC_TOKEN=00000000-0000-0000-0000-000000000000
HEC_INDEX=sao_alerts
HEC_SOURCETYPE=splunk:sao:alert
HEC_SOURCE=sao:webhook
# HEC_HOST defaults to the container hostname; override to tag the source system.
#HEC_HOST=sao-hec-bridge
# Set false only for a lab Splunk with a self-signed certificate.
HEC_VERIFY_TLS=true
HEC_TIMEOUT_SECONDS=10

# ---- SAO console deep links --------------------------------------------------
# SAO stamps deep_link with its own console host, which may not be the console
# your tenant uses. Set these to retarget it; leave SAO_CONSOLE_URL empty to
# pass SAO's link through untouched. Query string (time range + filters) is
# always preserved, and the original link is kept as deep_link_source.
SAO_CONSOLE_URL=https://console.multitenant.sao.splunkcloud.com
SAO_TENANT=your-tenant
SAO_STREAM_SEGMENT=agent-streams

# ---- Retry policy ------------------------------------------------------------
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=30

# ---- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
